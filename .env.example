# ── How env vars work in this project ────────────────────────────────────────
# Secrets live in AWS Secrets Manager and are loaded from .env.local
# (gitignored). One secret to dump: the staging app secret already holds every
# local-dev value (Cognito, Stripe test keys, Resend, ABR, Mapbox, S3).
#
#   aws secretsmanager get-secret-value \
#     --secret-id startline/staging/app \
#     --region ap-southeast-2 \
#     --query SecretString --output text | \
#     jq -r 'to_entries[] | "\(.key)=\(.value)"'
#
#   Write that into .env.local in the main checkout, then copy to each worktree:
#      cp /path/to/main/checkout/.env.local .
#
#   Do NOT read `startline/automation` for local dev. It is the trusted
#   CI/Terraform bundle and no longer owns the app runtime values. Local dev
#   credentials are scoped to `startline/staging/app` only.
#
#   Deployed runtime secrets live on each environment's own app secret:
#   `startline/staging/app` or `startline/prod/app`. An Amplify branch
#   variable is visible to the build, not to the route handlers.
#
#   Override DATABASE_URL for local Docker:
#      DATABASE_URL=postgresql://postgres:postgres@localhost:5432/startline?schema=public
#
# ── Database (local Docker) ──────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/startline?schema=public"

# ── SMTP (Docker Mailpit, UI at :8026) ───────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="1025"

# ── AWS / Cognito (auth — from startline/staging/app) ─────────────────────────
NEXT_PUBLIC_AWS_REGION="ap-southeast-2"
NEXT_PUBLIC_COGNITO_USER_POOL_ID="ap-southeast-2_xxxxxxxxx"
NEXT_PUBLIC_COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Mapbox (interactive map — events page + organiser location preview) ────────
# Required: without it EventMap and LocationPreviewMap show a token-missing state.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: defaults to mapbox://styles/mapbox/dark-v11
NEXT_PUBLIC_MAPBOX_STYLE_URL="mapbox://styles/mapbox/dark-v11"

# ── Stripe (payments — from startline/staging/app) ────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"
# Accounts v2 event destination (/api/stripe/account-events). Locally, the
# secret `pnpm stripe:listen:accounts` prints; deployed, `pnpm stripe:account-events`.
STRIPE_ACCOUNT_EVENTS_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"
# Dev only: charge the platform account directly instead of connected Stripe accounts
STRIPE_DEV_DIRECT_CHARGE="true"

# ── Resend (transactional email — from startline/staging/app) ─────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="Startline <hello@startlineau.com>"

# ── S3 uploads (cover images, photos — from startline/staging/app) ─────────────
# Local dev should use the least-privilege `startline-dev` IAM user. Create a
# profile with that name in ~/.aws/credentials; it can read the staging app
# secret and call Geo Places, but not read the production secret or Terraform
# state. Leave the static keys unset when the profile is present.
AWS_PROFILE="startline-dev"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="startline-uploads-xxxxxxxxxxxx"
AWS_S3_REGION="ap-southeast-2"
# Optional CDN in front of the uploads bucket
NEXT_PUBLIC_CDN_URL=""

# ── Site URLs (default to localhost:3000 when unset) ───────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── ABN lookup (ABR GUID — server-only, used by GET /api/abn + lib/abn.ts) ─────
# Free GUID: https://abr.business.gov.au/Documentation/UserGuideAbnLookupServices
# Store in .env.local locally; deployed values live on startline/staging/app and
# startline/prod/app.
ABR_GUID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ── Trusted proxy IP (rate limiting) ───────────────────────────────────────────
# Only enable when every request reaches the app through Cloudflare AND the
# Amplify origin cannot be called directly. Otherwise a direct caller can spoof
# CF-Connecting-IP. When unset, the limiter uses the nearest X-Forwarded-For hop.
TRUST_CF_CONNECTING_IP=""

# ── Cloudflare Turnstile (bot detection — public forms, checkout, reviews) ─────
# Site key is public (NEXT_PUBLIC_*); secret key is server-only. Terraform-managed
# via cloudflare-turnstile.tf — keys flow to the app secret + Amplify on apply.
# When unset the server fails open (no bot check) for local dev / E2E.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Dev-only ─────────────────────────────────────────────────────────────────────
